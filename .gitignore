# Backend (Python)
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
# Matches the db and every backup variant (.db.bak, .db.bak2, .db-wal, ...).
# The narrower `*.db` + `*.db.bak` pair missed a `.db.bak2` snapshot, which
# would have published every user's email and password hash.
backend/database/*.db*
backend/.env
backend/firebase-service-account.json
backend/*firebase*adminsdk*.json

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.env

# Editor / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
