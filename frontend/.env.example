VITE_API_URL=http://localhost:5000/api

# Firebase Auth (email/password + Google): set these to enable it — see
# frontend/.env for details on where to find these values.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Standalone social sign-in (used only when Firebase Auth above isn't
# configured): leave unset to disable. Must match the backend's
# GOOGLE_CLIENT_ID / FACEBOOK_APP_ID (see backend/.env.example).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your-facebook-app-id
