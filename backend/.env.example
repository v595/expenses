SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=True

# Phase 14: set this to switch the backend from local SQLite to production
# PostgreSQL. Leave unset for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Social sign-in: leave unset to disable. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID (see frontend/.env.example).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
