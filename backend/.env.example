SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=True

# Phase 14: set this to switch the backend from local SQLite to production
# PostgreSQL. Leave unset for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated frontend origin(s) allowed to call this API. Required in
# production (FLASK_DEBUG=False) — CORS is wide open when unset, which is
# fine only for local dev.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Social sign-in: leave unset to disable. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID (see frontend/.env.example).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- Payment reminders (messaging driver) ---------------------------------
# Which driver prepares/sends reminder messages. Defaults to `wa_link`, which
# needs no configuration and no provider account: it builds a WhatsApp
# click-to-chat link (https://wa.me/<number>?text=<message>) that the user
# opens and sends themselves. The other two are stubs — they read the
# credentials below and refuse with an explanatory error until they're set.
# MESSAGING_DRIVER=wa_link          # wa_link (default) | twilio | msg91

# Twilio (SMS/WhatsApp). Requires a paid Twilio account; the outbound API
# call itself is still a TODO in app/services/messaging/twilio.py.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM=+15551234567

# MSG91 (Indian SMS). Requires an MSG91 account AND DLT registration of the
# sender id and every message template with the Indian telecom registry —
# without that, transactional SMS to Indian numbers is simply not deliverable.
# The outbound API call is a TODO in app/services/messaging/msg91.py.
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=EXPTRK

# --- Password reset (email driver) -----------------------------------------
# Which driver sends "forgot password" emails. Defaults to `console`, which
# needs no provider account: it logs the reset link instead of emailing it
# (see it in the backend's own log output).
# EMAIL_DRIVER=resend               # console (default) | smtp | resend

# smtp: works with any SMTP-capable provider (Gmail app password, SendGrid,
# Mailgun, ...). NOTE: most PaaS hosts (Render included) block outbound SMTP
# ports entirely, so this fails there with "Network is unreachable" no
# matter how correct the credentials are — use `resend` on a host like that.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@yourapp.com    # defaults to SMTP_USER if unset

# resend: sends over HTTPS instead of raw SMTP, so it isn't blocked by hosts
# that block SMTP ports. Free tier, no card required — sign up at resend.com.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev  # resend's shared test sender; verify your
#                                     # own domain in Resend to send to anyone

# The origin the reset link points back to. Defaults to the Vite dev server;
# set this to the deployed frontend's URL (no trailing slash) in production.
# FRONTEND_URL=https://your-frontend.vercel.app
